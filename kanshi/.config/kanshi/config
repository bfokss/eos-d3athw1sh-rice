profile docked {
    output DP-1 mode --custom 2560x1440@59.95Hz scale 1 position 0,0
    output HDMI-A-1 mode --custom 1920x1080@60 scale 1 position -1080,-250 transform 270
    output eDP-1 disable

    #Hyprland dock specific config
    exec cp ~/.config/hypr/modules/dock_env.conf ~/.config/hypr/env.conf
    exec cp ~/.config/hypr/modules/dock_workspaces.conf ~/.config/hypr/workspaces.conf
    exec cp ~/.config/hypr/modules/dock_monitors.conf ~/.config/hypr/monitors.conf
    #Hyprlock dock specific config
    exec cp ~/.config/hypr/hyprlock/modules/dock_monitor.conf ~/.config/hypr/hyprlock/current_monitor.conf
    exec hyprctl reload
}

profile laptop {
    output eDP-1 mode --custom 1920x1080@60Hz scale 1 position 0,0

    #Hyprland laptop specific config
    exec cp ~/.config/hypr/modules/laptop_env.conf ~/.config/hypr/env.conf
    exec cp ~/.config/hypr/modules/laptop_workspaces.conf ~/.config/hypr/workspaces.conf
    exec cp ~/.config/hypr/modules/laptop_monitors.conf ~/.config/hypr/monitors.conf
    #Hyprlock laptop specific config
    exec cp ~/.config/hypr/hyprlock/modules/laptop_monitor.conf ~/.config/hypr/hyprlock/current_monitor.conf
    exec hyprctl reload
}